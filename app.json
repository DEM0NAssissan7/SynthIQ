    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/favicon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.synthiq.app",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./public/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a2bc8b20-40a7-4564-8fe5-f471d491f8e5"
      }
    }
  }
}
