{
  "name": "synthiq",
  "version": "0.1.0",
  "author": "Abdurahman Elmawi",
  "description": "A smart web frontend to nightscout",
  "license": "GPL-3.0-or-later",
  "private": false,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "css": "sass src/index.scss src/index.css",
    "bundle-html": "node scripts/build-html-bundle.js",
    "dev": "npm run css && vite",
    "build": "npm run css && tsc -b && vite build && npm run bundle-html",
    "lint": "eslint .",
    "preview": "vite preview",
    "build-podman": "npm run build && podman build . -t synthiq",
    "build-docker": "npm run build && docker build . -t synthiq",
    "expo:start": "npm run build && expo start",
    "expo:android": "npm run build && expo run:android",
    "expo:web": "npm run css && vite --host",
    "build-android": "npm run build && npx expo prebuild --platform android && android/gradlew -p android assembleRelease",
    "android-eas-build": "npm run build && npx eas-cli build --platform android --profile preview",
    "eas-build-post-install": "npm run build"
  },
  "dependencies": {
    "@expo/metro-runtime": "^57.0.8",
    "@reduxjs/toolkit": "^2.8.2",
    "bootstrap": "^5.3.6",
    "bootstrap-icons": "^1.13.1",
    "expo": "^57.0.9",
    "expo-file-system": "^57.0.4",
    "expo-sharing": "^57.0.13",
    "fmin": "https://github.com/DEM0NAssissan7/fmin/tarball/master",
    "pako": "^2.1.0",
    "react": "^19.1.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.1.0",
    "react-native": "^0.86.2",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^14.0.1",
    "react-redux": "^9.2.0",
    "react-router": "^7.6.0",
    "recharts": "^2.15.3",
    "vite-plugin-pwa": "^1.3.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@babel/plugin-transform-dynamic-import": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@eslint/js": "^9.25.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "babel-preset-expo": "^57.0.5",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "sass-embedded": "^1.89.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
